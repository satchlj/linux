/* The inherited USB DARTs have no secure-monitor power-down operation in
 * Linux's direct T8110 backend. Do not cut their domain from pre-freezer
 * Type-C teardown or system PM. Router-only CIO domains remain cycleable.
 * Keeping USB also retains its AON/common suppliers for wake. This can be
 * relaxed only with a qualified DART ownership/power-down handoff. */
&ps_atc0_usb { apple,always-on; };
&ps_atc1_usb { apple,always-on; };
&ps_atc2_usb { apple,always-on; };
&ps_atc3_usb { apple,always-on; };
