/*
 * J775c's four rear routers. Shared MMIO/IRQ/stream resources are in
 * t6050-acio.dtsi and t6050-max.dtsi. The loader fills RC, NHI and DART tunables and
 * the DROMs through the aliases; no unit identity is embedded here.
 */

/ {
	aliases {
		usb4-0-acio = &acio0;
		usb4-0-nhi = &acio0_nhi;
		usb4-1-acio = &acio1;
		usb4-1-nhi = &acio1_nhi;
		usb4-2-acio = &acio2;
		usb4-2-nhi = &acio2_nhi;
		usb4-3-acio = &acio3;
		usb4-3-nhi = &acio3_nhi;
	};
};

&pinctrl_aop {
	/* The four router LSTX pins, 77/79/81/83. */
	gpio-reserved-ranges = <0 77>, <78 1>, <80 1>, <82 1>, <84 1>;
	status = "okay";
};

&ps_auss {
	status = "okay";
};

&cio_reconfig0 {
	status = "okay";
};

&ps_atc0_cio {
	status = "okay";
};

&ps_atc0_cio_pcie {
	status = "okay";
};

&ps_atc0_cio_usb {
	status = "okay";
};

&ps_atc0_cio_auss {
	status = "okay";
};

&acio0_mbox {
	status = "okay";
};

&atc0_phy {
	apple,tunable-lane0-rx-top-cio = <0x35c 0xe00 0x200>;
	apple,tunable-lane1-rx-top-cio = <0x35c 0xe00 0x200>;
};

&acio0 {
	status = "okay";
	apple,tunable-pcie-adapter = <0x1008 0x6 0x6>;
	apple,tunable-router-ap-fw = <0x8 0xff2 0x482>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			acio0_tbt: endpoint {
				remote-endpoint = <&hpm0_usb4>;
			};
		};
	};
};


&hpm0 {
	connector {
		ports {
			port@3 {
				reg = <3>;
				hpm0_usb4: endpoint {
					remote-endpoint = <&acio0_tbt>;
				};
			};
		};
	};
};

